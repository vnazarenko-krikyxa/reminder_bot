# ===== Обов'язково =====
# Токен бота від @BotFather
TELEGRAM_TOKEN=
# Твій Telegram user id (дізнатися: @userinfobot). Кілька — через кому. Порожньо = бот відповідає всім (не радимо).
ALLOWED_USER_IDS=
TZ_NAME=Europe/Kyiv
# Коли надсилати ранкові нагадування
REMIND_TIME=10:30
EVENING_HOUR=19

# ===== Голос і вільний текст (дуже бажано) =====
# Ключ будь-якої LLM — провайдера бот визначить за ключем сам:
# Groq (gsk_…, безкоштовно, є голос) · OpenAI (sk-proj-…, є голос) · Anthropic (sk-ant-…) · Gemini (AIza…)
# OpenRouter (sk-or-…) · xAI (xai-…) · DeepSeek / Mistral (перевіряються запитом)
LLM_API_KEY=
# Необов'язково: якщо ключ не розпізнався — groq | openai | anthropic | gemini | openrouter | xai | deepseek | mistral
LLM_PROVIDER=
# Необов'язково: своя модель замість типової (напр. claude-haiku-5-5, gpt-4o-mini)
LLM_MODEL=
# Необов'язково: свій OpenAI-сумісний сервер (Ollama, LM Studio…) — тоді обов'язково LLM_MODEL
LLM_BASE_URL=
# Голос, якщо твій провайдер не розпізнає мову (Anthropic, Gemini, OpenRouter, xAI…): ключ Groq або OpenAI
STT_API_KEY=

# ===== Робота: листи про відсутність, «Не на місці», зустрічі (необов'язково) =====
# Потрібен Google Workspace/Gmail і google_auth.py — див. SETUP.md
WORK_EMAIL_FROM=you@company.com
WORK_EMAIL_TO=team@company.com
# Ник на початку теми листа: «Nick / Відгул / 28.09.26». Простіше задати в боті командою /nick.
WORK_NICK=
# Робочі години для відгулу/лікарняного в календарі
WORK_DAY=08:00-19:00
# Заповнює google_auth.py автоматично
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
